# Vite envs — copy to .env.local for dev.
#
# Local dev: leave empty so Vite proxy in vite.config.ts handles `/api` and `/auth`.
# Production builds (Cloudflare Pages): MUST be set to the Workers origin,
#   e.g. https://costco-tw-price-match-api.workers.dev
# The build will throw at startup if this is missing in prod mode.

VITE_API_BASE_URL=
